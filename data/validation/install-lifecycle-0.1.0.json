{
  "schema": 2,
  "release": "0.1.0",
  "kind": "LOCAL_CONFIG_LIFECYCLE_R2",
  "claim_boundary": "Local project config/setup lifecycle only. This receipt proves install/reconfigure/owned upgrade/rollback/uninstall/interrupted-transaction recovery and preservation semantics; it is not npm publication or external OpenCode runtime acceptance.",
  "operations": {
    "plan": "READY",
    "install": "APPLIED",
    "idempotent_install": "NOOP",
    "upgrade": "APPLIED",
    "rollback_upgrade": "APPLIED",
    "reconfigure": "APPLIED",
    "doctor_installed": "OK",
    "uninstall": "APPLIED",
    "rollback_uninstall": "APPLIED",
    "doctor_restored": "OK",
    "final_uninstall": "APPLIED",
    "recover_interrupted_upgrade": "RECOVERED"
  },
  "assertions": {
    "upgrade_target_observed": true,
    "upgrade_rollback_restored_0_1_0": true,
    "uninstall_removed_only_owned_registration": true,
    "uninstall_rollback_restored_registration": true,
    "foreign_config_preserved_through_upgrade_rollback": true,
    "foreign_config_preserved_through_uninstall": true,
    "foreign_config_preserved_after_final_uninstall": true,
    "final_hi_registration_absent": true,
    "normal_transaction_journal_cleaned": true,
    "interrupted_upgrade_recovered_to_target": true,
    "recovery_transaction_cleaned": true,
    "recovery_published_one_rollback_point": true
  },
  "state_security": {
    "setup_json_mode": "0o600",
    "rollback_mode_after_install": "0o600",
    "rollback_mode_after_final_uninstall": "0o600",
    "transaction_contains_config_body": false,
    "rollback_contains_config_body": false,
    "state_contains_only_registration_identity_hash_index_and_setup_ownership_metadata": true
  },
  "ownership": {
    "active_setup": ".opencode/hi/provenance/setup.json",
    "transient_transaction": ".opencode/hi/provenance/setup-transaction.json",
    "bounded_rollback": ".opencode/hi/provenance/setup-rollback.json",
    "foreign_config_owner": "user/OpenCode",
    "project_policy_owner": "independent Hi policy owners"
  },
  "external_host_status": "SEPARATE_T3_BOUNDARY"
}
