{
  "schema": 1,
  "scenarios": {
    "Flow-01": {
      "name": "stop-then-new-task",
      "expects": [
        "old-mission-remains-stopped",
        "new-message-creates-new-mission",
        "late-old-generation-callbacks-ignored"
      ]
    },
    "Flow-02": {
      "name": "explicit-resume",
      "expects": [
        "explicit-resume-reactivates-same-mission",
        "generation-advances",
        "no-generic-authority-approval"
      ]
    },
    "Flow-03": {
      "name": "active-followup-amendment",
      "expects": [
        "followup-obligation-added",
        "existing-workers-not-invalidated",
        "completion-waits-for-followup"
      ]
    },
    "Flow-04": {
      "name": "followup-risk-escalation",
      "expects": [
        "mission-risk-only-escalates",
        "verification-policy-widens",
        "security-or-authority-gate-added-when-needed"
      ]
    },
    "Flow-05": {
      "name": "permission-wait-end-to-end",
      "expects": [
        "permission-asked-counted",
        "idle-waits",
        "no-stagnation",
        "permission-replied-releases-wait"
      ]
    },
    "Flow-06": {
      "name": "native-event-to-ledger",
      "expects": [
        "opencode-event-normalized",
        "thin-hi-signal-adapter",
        "ledger-persists-compact-event",
        "no-second-broker"
      ]
    },
    "Flow-07": {
      "name": "stale-evidence-completion",
      "expects": [
        "mutation-invalidates-evidence",
        "completion-rejects-stop",
        "targeted-verification-required"
      ]
    },
    "Flow-08": {
      "name": "pending-child-completion",
      "expects": [
        "active-worker-blocks-stop",
        "native-idle-result-reconciled",
        "parent-wake-without-polling"
      ]
    }
  },
  "release": "0.1.2"
}
