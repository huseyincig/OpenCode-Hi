{
  "schema": 1,
  "type": "hi-documentation-ownership",
  "policy": {
    "rule": "one-current-area-one-public-owner",
    "truth_precedence": "live-source-contract-runtime-evidence-before-docs",
    "historical_or_local_notes_may_not_own_current_truth": true,
    "generated_facts_must_name_machine_owner": true,
    "public_docs_budget": 12,
    "root_markdown_budget": 3,
    "local_only_directory": ".project-docs/",
    "engineering_state_root_markdown": [
      "PROTOCOL.md",
      "ROADMAP.md",
      "TASKS.md"
    ]
  },
  "public_documents": [
    {
      "path": "README.md",
      "area": "product-overview",
      "audience": "USER",
