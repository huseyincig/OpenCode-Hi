# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Build/release — only top-level dist/build are Python packaging outputs.
# plugin/dist/ is the canonical plugin runtime (committed).
/dist/
/build/
*.zip

# Node / package manager transient artifacts (anywhere in the tree)
node_modules/
.pnp.*

# Local engineering/test/runtime artifacts; never repository source.
/.agent-work/
/.cache/
/coverage/
/tmp/
/temp/
*.log
*.tmp
*.bak

# Local model/user configuration
model-bindings.local.*
.env
.env.*

# IDE/OS
.DS_Store
Thumbs.db

# OpenCode project-local workspace/config; never part of the OpenCode-Hi product source.
.opencode/
# Root opencode.jsonc (development workspace config; private local MCP URLs).
# Use opencode.jsonc.example as a generic template for fresh consumer installs.
opencode.jsonc

# Local-only engineering/history documentation; intentionally never published.
.project-docs/

# Local-only AI/engineering governance and continuation state; never publish.
/AGENTS.md
/PROJECT_POLICY.md
/PROTOCOL.md
/ROADMAP.md
/TASKS.md
/agent-archive/
