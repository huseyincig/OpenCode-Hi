{
  "name": "opencode-hi",
  "version": "0.2.0",
  "description": "Evidence-aware adaptive execution and Hybrid Intelligence control plane for OpenCode.",
  "type": "module",
  "main": "plugin/dist/plugin.js",
  "exports": {
    ".": {
      "types": "./plugin/dist/plugin.d.ts",
      "import": "./plugin/dist/plugin.js"
    }
  },
  "files": [
    "plugin/dist",
    "skills",
    "scripts/native_plugin_setup.py",
    "VERSION",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs",
    ".github/CONTRIBUTING.md",
    ".github/SECURITY.md",
    ".github/SUPPORT.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huseyincig/OpenCode-Hi.git"
  },
  "homepage": "https://github.com/huseyincig/OpenCode-Hi#readme",
  "bugs": {
    "url": "https://github.com/huseyincig/OpenCode-Hi/issues"
  },
  "keywords": [
    "opencode",
    "hybrid-intelligence",
    "adaptive-execution",
    "ai",
    "plugin"
  ],
  "license": "Apache-2.0",
  "types": "plugin/dist/plugin.d.ts",
  "scripts": {
    "build": "npm --prefix plugin run build",
    "test": "npm --prefix plugin test",
    "check": "npm run check:product && npm run check:evidence",
    "prepack": "npm run build",
    "contracts:generate": "npm --prefix plugin run build",
    "architecture:lint": "npm --prefix plugin run architecture:lint",
    "projections:check": "npm --prefix plugin run projections:check",
    "behavior:accept": "npm --prefix plugin test",
    "docs:check": "node scripts/run-python.mjs scripts/generate-product-truth-inventory.py && node scripts/run-python.mjs scripts/generate-documentation-projections.py && node scripts/run-python.mjs scripts/generate-documentation-inventory.py && node scripts/run-python.mjs scripts/validate-documentation.py",
    "check:product": "npm --prefix plugin run check && npm run docs:check",
    "check:evidence": "node scripts/run-python.mjs scripts/validate.py && npm run test:python:all",
    "test:python:product": "node scripts/run-python.mjs -m pytest -q -m \"not evidence\" tests/test_hi.py",
    "test:python:all": "node scripts/run-python.mjs -m pytest -q tests/test_hi.py",
    "docs:pack-check": "node scripts/run-python.mjs scripts/audit-packed-public-docs.py"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "opencode-hi-setup": "scripts/native_plugin_setup.py"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "1.18.18"
  },
  "dependencies": {
    "@opencode-ai/sdk": "1.18.18"
  },
  "optionalDependencies": {
    "playwright-core": "1.62.1"
  }
}
